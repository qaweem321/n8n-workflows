# Encrypts the credentials n8n stores. Generate: openssl rand -hex 32 (min 32 characters).
# Keep it: if it changes, n8n can no longer read credentials saved with the old key.
N8N_ENCRYPTION_KEY=

# Only needed to record demo videos (npm run demo:*): the n8n owner login you created.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=
